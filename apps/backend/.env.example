# Nothing in this file needs to be filled in.
#
# `npm install` fills in BETTER_AUTH_SECRET automatically. Everything else is
# set up in the app itself:
#   - first visit: connect PostgreSQL, then create the administrator and
#     enter the Tencent COS bucket for uploaded files
#   - Settings: Gemini API key, SMTP, branding
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------------------
# Optional overrides — only for automated/advanced deployments. Leave them
# commented out for a normal install; values set in the app take priority.
# ---------------------------------------------------------------------------

# PostgreSQL connection. Unset, the first visit asks for it and saves it to
# APP_DATA_DIR/database.json. Docker Compose sets it for the bundled service.
# DATABASE_URL=postgres://legalio:legalio@127.0.0.1:5432/legalio

# Pin the app to one exact public URL / add extra trusted origins (comma
# separated). Unset, the app trusts whatever domain it's actually reached on.
# BETTER_AUTH_URL=
# TRUSTED_ORIGINS=

# Pre-create the first administrator instead of using the setup page.
# SEED_DEMO_ADMIN=false stops re-applying it once your own admin exists.
# DEMO_ADMIN_EMAIL=
# DEMO_ADMIN_PASSWORD=
# SEED_DEMO_ADMIN=true

# Instead of the in-app settings.
# GEMINI_API_KEY=

# Per-attempt AI timeout in milliseconds (default 35000). Raise it when documents are long or the
# provider is reached through a proxy: a timed-out attempt is not retried on the same model.
# AI_ATTEMPT_TIMEOUT_MS=90000

# Optional absolute directory containing the separately built /sys console.
# Default: apps/backend/dist/console in the repository/image.
# SYSTEM_CONSOLE_DIR=/absolute/path/to/backend/dist/console
