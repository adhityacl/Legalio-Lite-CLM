{
  "name": "legalio",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:sys && npm run dev:combined --workspace @legalio/backend",
    "dev:backend": "npm run build:sys && npm run dev --workspace @legalio/backend",
    "dev:frontend": "npm run dev --workspace @legalio/frontend",
    "setup": "node scripts/setup-env.mjs",
    "postinstall": "node scripts/setup-env.mjs",
    "build": "turbo run build",
    "build:frontend": "npm run build --workspace @legalio/frontend",
    "build:backend": "npm run build --workspace @legalio/backend",
    "start": "npm run start --workspace @legalio/backend",
    "clean": "node scripts/clean-build.mjs",
    "lint": "turbo run lint --concurrency=1 && tsc --noEmit",
    "auth:generate": "npm run auth:generate --workspace @legalio/backend",
    "auth:migrate": "npm run auth:migrate --workspace @legalio/backend",
    "build:sys": "npm run build:console --workspace @legalio/backend",
    "dev:sys": "npm run dev:console --workspace @legalio/backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "turbo": "^2.5.0"
  }
}
