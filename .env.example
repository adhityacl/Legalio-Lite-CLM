# Docker Compose settings (copy to `.env` next to compose.yaml; never commit `.env`).
#
# REQUIRED: password for the bundled PostgreSQL service. Compose refuses to start without it.
# It is applied when the database volume is first created; changing it later does not change an existing database.
# Generate one with:  openssl rand -base64 24
POSTGRES_PASSWORD=

# Optional: where the web app is published. Defaults shown.
# FRONTEND_BIND=0.0.0.0
# FRONTEND_PORT=8080
# Backend API port (normally only reached through nginx; keep it on loopback).
# BACKEND_BIND=127.0.0.1
# BACKEND_PORT=3000

# Optional: which proxies the backend trusts for X-Forwarded-* (hop count like 1, or an address list).
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Optional: request limits on login/setup endpoints (per client address).
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_DISABLED=false
